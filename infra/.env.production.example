# Copie para ../.env.production no servidor. Nunca envie esse arquivo preenchido ao Git.
SISMOD_DEBUG=false
SISMOD_SECRET_KEY=gere-uma-chave-longa-e-aleatoria
SISMOD_DOMAIN=sismod.exemplo.com
SISMOD_MEDIA_DOMAIN=midia.sismod.exemplo.com
SISMOD_TLS_EMAIL=infraestrutura@exemplo.com
SISMOD_ALLOWED_HOSTS=sismod.exemplo.com
SISMOD_CSRF_TRUSTED_ORIGINS=https://sismod.exemplo.com
SISMOD_BEHIND_HTTPS_PROXY=true
SISMOD_SECURE_SSL_REDIRECT=true
SISMOD_SESSION_COOKIE_SECURE=true
SISMOD_CSRF_COOKIE_SECURE=true
SISMOD_SECURE_HSTS_SECONDS=31536000
SISMOD_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SISMOD_SECURE_HSTS_PRELOAD=false
SISMOD_DB_PASSWORD=troque
SISMOD_STORAGE_ACCESS_KEY=troque
SISMOD_STORAGE_SECRET_KEY=troque
SISMOD_TLS_CERT_FILE=/caminho/no/host/fullchain.pem
SISMOD_TLS_KEY_FILE=/caminho/no/host/privkey.pem
SISMOD_TURN_SECRET=troque
SISMOD_MEDIAMTX_AUTH_SECRET=troque-por-outro-segredo
SISMOD_MEDIAMTX_TOKEN_TTL_SECONDS=900
SISMOD_HEALTHCHECK_TOKEN=
SISMOD_SESSION_IDLE_SECONDS=28800
SISMOD_LOGIN_MAX_FAILURES=5
SISMOD_LOGIN_WINDOW_SECONDS=900
SISMOD_LOGIN_BLOCK_SECONDS=900
SISMOD_MFA_ADMIN_REQUIRED=false
SISMOD_MFA_ISSUER=SISMOD
SISMOD_AUDIT_RETENTION_DAYS=730
SISMOD_REAUTH_SECONDS=300
SISMOD_CLAMAV_HOST=
SISMOD_CLAMAV_PORT=3310
SISMOD_CLAMAV_REQUIRED=false
DJI_LIVESTREAM_ENABLED=true
DJI_LIVESTREAM_RTMP_BASE_URL=rtmps://midia.sismod.exemplo.com:1936
DJI_LIVESTREAM_PLAYBACK_BASE_URL=https://midia.sismod.exemplo.com
SISMOD_MEDIAMTX_API_URL=http://mediamtx:9997
DJI_DOCK_ENABLED=false
DJI_CLOUD_MQTT_HOST=ssl://mqtt.empresa.exemplo:8883
DJI_DOCK_MQTT_USERNAME=sismod-consumer
DJI_DOCK_MQTT_PASSWORD=troque
DJI_DOCK_MQTT_PUBLISHER_USERNAME=sismod-publisher
DJI_DOCK_MQTT_PUBLISHER_PASSWORD=troque
DJI_DOCK_MQTT_CA_CERT=/certificados/ca-mqtt.pem
DJI_DOCK_COMMANDS_ENABLED=false
DJI_DOCK_PUBLISHER_ENABLED=false
DJI_DOCK_EMERGENCY_STOP=true
DJI_DOCK_COMMAND_RATE_LIMIT_SECONDS=5
