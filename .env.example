DJI_FLIGHT_RECORD_APP_KEY=
SISMOD_ALLOWED_HOSTS=127.0.0.1,localhost
SISMOD_CSRF_TRUSTED_ORIGINS=

# Licença anual offline (chave pública Ed25519 em Base64)
SISMOD_LICENSE_ENFORCEMENT=false
SISMOD_LICENSE_PUBLIC_KEY=

# DJI Open Platforms / Cloud API
DJI_CLOUD_ENABLED=false
DJI_CLOUD_APP_ID=
DJI_CLOUD_APP_KEY=
DJI_CLOUD_APP_LICENSE=
DJI_CLOUD_WORKSPACE_ID=
DJI_CLOUD_PUBLIC_URL=https://sismod.exemplo.com
DJI_CLOUD_API_HOST=https://sismod.exemplo.com
DJI_CLOUD_MQTT_HOST=
DJI_CLOUD_MQTT_USERNAME_PREFIX=sismod-pilot
DJI_CLOUD_PLATFORM_NAME=SISMOD
DJI_CLOUD_WORKSPACE_NAME=Operações SISMOD
DJI_CLOUD_WORKSPACE_DESCRIPTION=Monitoramento e gestão de operações com drones
DJI_DOCK_ENABLED=false
DJI_DOCK_COMMANDS_ENABLED=false
DJI_DOCK_OFFLINE_AFTER_SECONDS=120
# Apenas para homologação local; mantenha false em produção.
DJI_DOCK_SIMULATOR_ENABLED=false
DJI_DOCK_MQTT_USERNAME=
DJI_DOCK_MQTT_PASSWORD=
DJI_DOCK_MQTT_CLIENT_ID=sismod-dock-consumer
DJI_DOCK_MQTT_TOPIC=sys/product/+/status,thing/product/+/osd,thing/product/+/state,thing/product/+/events,thing/product/+/services_reply
DJI_DOCK_MQTT_CA_CERT=
DJI_DOCK_WPML_URL_TTL_SECONDS=3600
DJI_DOCK_COMMAND_TTL_SECONDS=300

# Arquivos do SISMOD: local, s3 ou minio.
SISMOD_MEDIA_STORAGE=local
SISMOD_STORAGE_BUCKET=sismod-media
SISMOD_STORAGE_ACCESS_KEY=
SISMOD_STORAGE_SECRET_KEY=
SISMOD_STORAGE_REGION=us-east-1
# MinIO: https://minio.exemplo.com; S3 AWS: deixe vazio.
SISMOD_STORAGE_ENDPOINT_URL=

# PostgreSQL (se SISMOD_DB_HOST ficar vazio, o desenvolvimento usa SQLite).
SISMOD_DB_HOST=
SISMOD_DB_PORT=5432
SISMOD_DB_NAME=sismod
SISMOD_DB_USER=sismod
SISMOD_DB_PASSWORD=

# Transmissão ao vivo (MediaMTX/SRS). Ative somente no servidor público.
DJI_LIVESTREAM_ENABLED=false
DJI_LIVESTREAM_RTMP_BASE_URL=rtmps://midia.sismod.exemplo.com/live
DJI_LIVESTREAM_PLAYBACK_BASE_URL=https://midia.sismod.exemplo.com
